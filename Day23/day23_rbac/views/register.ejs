<h2>Register</h2>

<% if (errors) { errors.forEach(e => { %>
  <p><%= e %></p>
<% }) } %>

<% if (success) { %>
  <p><%= success %></p>
<% } %>

<form method="POST">
  <input name="name" value="<%= name %>" required placeholder="Name">
  <input name="email" value="<%= email %>" required placeholder="Email">
  <input name="password" type="password" required placeholder="Password">
  <input name="password2" type="password" required placeholder="Confirm Password">
  <button>Register</button>
</form>
